    "book": "hymnal",
    "no": 128,
    "title": "我今俯伏主面前",
    "firstLine": "我今俯伏主面前，我希奇主恩典",
    "categories": [
      "讚美主",
      "記念主",
      "感恩",
      "主的救贖"
    ],
    "key": "F大調",
